# Batgos Backend — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env.

# ── Server ────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Supabase ──────────────────────────────────────
# SERVICE_ROLE_KEY bypasses RLS. Server-side only — never expose it to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── JWT ───────────────────────────────────────────
JWT_SECRET=generate-a-long-random-string-for-production
JWT_EXPIRES_IN=7d

# ── Platform admin ────────────────────────────────
# Comma-separated. An address listed here is promoted to gyms.role='admin' on
# its next login. Platform role is NOT derived from plan_type.
SUPER_ADMIN_EMAIL=

# ── Support contact ───────────────────────────────
# Shown to gym owners in the "your access is suspended" message.
SUPPORT_CONTACT=

# ── Frontend ──────────────────────────────────────
# Comma-separated list of allowed browser origins (CORS). In development, LAN
# addresses (localhost / 192.168.x.x / 10.x.x.x) are additionally allowed so you
# can test on a phone.
FRONTEND_URL=http://localhost:5173

# ── Rate Limiting ─────────────────────────────────
# Window in ms, and the ceiling for general /api traffic. Credential endpoints
# (/api/auth/login, forgot-password, reset-password, register) use their own
# much tighter limits defined in server.js.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# ── WhatsApp worker (Phase 6) ────────────────────────────────
# Optional. Leave blank and every gym falls back to click-to-send wa.me links,
# which is the default and carries no ban risk.
#
# The worker is a separate long-lived process (see wa-worker/README.md). It
# cannot run on Vercel — Baileys holds a persistent socket that a serverless
# runtime freezes between invocations.
WA_WORKER_URL=
# Must match WA_WORKER_TOKEN in wa-worker/.env. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WA_WORKER_TOKEN=
